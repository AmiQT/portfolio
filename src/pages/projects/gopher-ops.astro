---
import Layout from "../../layouts/Layout.astro";
import Icon from "../../components/shared/Icon.astro";

const baseUrl = import.meta.env.BASE_URL;

const project = {
    title: "Gopher-Ops",
    type: "AI-Driven SRE ChatOps Platform",
    category: "devops",
    status: "active",
    description: "AI SRE bot engineered in Go + Gemini 2.5 to manage Docker containers and Kubernetes clusters via natural language. Features a 1-hour in-memory metric history buffer for Automated Root Cause Analysis (RCA), Model Context Protocol (MCP) Kubernetes integration, and HITL Telegram execution.",
    tech: ["Go 1.22+", "Kubernetes", "MCP Go SDK", "MCP Server K8s", "Gemini 2.5 Flash", "Docker SDK", "Terraform", "GitHub Actions"],
    github: "https://github.com/AmiQT/Gopher-Ops",
};

const features = [
    {
        icon: "kubernetes",
        title: "MCP Server Kubernetes & Docker Control",
        desc: "Connects AI agents directly to native Kubernetes tooling via Model Context Protocol (MCP) and Docker SDK for natural language cluster operations.",
        highlight: true,
    },
    {
        icon: "cpu",
        title: "Automated Root Cause Analysis (RCA)",
        desc: "Maintains a 1-hour in-memory metric buffer to detect load spikes and trigger automated Gemini AI RCA when nodes or containers fail.",
        highlight: true,
    },
    {
        icon: "user",
        title: "Human-In-The-Loop (HITL) Triage",
        desc: "Guided incident triage with interactive Telegram inline approval buttons before executing state-mutating infrastructure commands.",
    },
    {
        icon: "shield",
        title: "Zero-Trust Chat ID Gating",
        desc: "Strict Telegram identity verification ensuring only authorized SREs can query telemetry or control cluster workloads.",
    },
];
---

<Layout
    title="Gopher-Ops | AI SRE Bot | Noor Azami"
    description={project.description}
    canonical="/projects/gopher-ops"
>
    <main class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12">

        <!-- Breadcrumb -->
        <div class="flex items-center gap-2 text-[#8b949e] text-sm font-mono mb-8">
            <a href={baseUrl} class="hover:text-white transition-colors">home</a>
            <span>/</span>
            <a href={baseUrl + "projects"} class="hover:text-white transition-colors">projects</a>
            <span>/</span>
            <span class="text-[#e6edf3]">gopher-ops</span>
        </div>

        <!-- Header Card -->
        <div class="bg-[#161b22] border border-[#30363d] rounded-xl p-6 sm:p-8 mb-8">
            <div class="flex flex-col sm:flex-row sm:items-start gap-4 mb-6">
                <span class="text-[#8b949e] shrink-0"><Icon name="robot" class="w-10 h-10" /></span>
                <div class="flex-1">
                    <div class="flex flex-wrap items-center gap-2 mb-1">
                        <h1 class="text-2xl font-bold text-white">{project.title}</h1>
                        <span class="flex items-center text-xs text-green-400 bg-green-500/10 border border-green-500/25 px-2 py-0.5 rounded-full font-mono">
                            Active
                        </span>
                        <span class="text-xs text-blue-400 bg-blue-500/10 border border-blue-500/25 px-2 py-0.5 rounded-full font-mono">DevOps</span>
                    </div>
                    <p class="text-[#8b949e] text-sm font-mono mb-3">{project.type}</p>
                    <p class="text-[#e6edf3] text-sm leading-relaxed">{project.description}</p>
                </div>
            </div>

            <!-- Tech Tags -->
            <div class="flex flex-wrap gap-1.5 mb-6">
                {project.tech.map(t => (
                    <span class="text-xs font-mono px-2.5 py-1 bg-[#21262d] text-[#e6edf3] rounded border border-[#30363d]">{t}</span>
                ))}
            </div>

            <!-- Actions -->
            <div class="flex flex-wrap gap-3 pt-5 border-t border-[#30363d]">
                <a
                    href={project.github}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-2 px-4 py-2 bg-[#21262d] text-[#e6edf3] text-sm font-semibold rounded-lg border border-[#30363d] hover:border-[#8b949e] transition-colors"
                >
                    <Icon name="github" class="w-4 h-4" />
                    View on GitHub
                </a>
            </div>
        </div>

        <!-- Features -->
        <div class="mb-8">
            <h2 class="text-sm font-semibold text-white font-mono mb-4">// key_features</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                {features.map(f => (
                    <div class={`bg-[#161b22] border rounded-xl p-5 flex gap-4 ${f.highlight ? "border-blue-500/40" : "border-[#30363d]"}`}>
                        <span class={`shrink-0 mt-0.5 ${f.highlight ? "text-blue-400" : "text-[#8b949e]"}`}>
                            <Icon name={f.icon} class="w-5 h-5" />
                        </span>
                        <div>
                            <h3 class="font-semibold text-[#e6edf3] text-sm mb-1">{f.title}</h3>
                            <p class="text-xs text-[#8b949e] leading-relaxed">{f.desc}</p>
                        </div>
                    </div>
                ))}
            </div>
        </div>

        <!-- Back -->
        <div class="flex items-center gap-4">
            <a
                href={baseUrl + "projects"}
                class="inline-flex items-center gap-2 px-4 py-2 bg-[#21262d] text-[#e6edf3] text-sm font-mono rounded-lg border border-[#30363d] hover:border-[#8b949e] transition-colors"
            >
                ← Back to Projects
            </a>
        </div>

    </main>
</Layout>
